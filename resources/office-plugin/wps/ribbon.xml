<customUI xmlns="http://schemas.microsoft.com/office/2006/01/customui" onLoad="OnAddinLoad">
  <ribbon startFromScratch="false">
    <tabs>
      <tab id="literaturexTab" label="LiteratureX" keytip="L">
        <group id="literaturexGroup" label="LiteratureX">
          <button
            id="btnAddEditCitation"
            label="插入/编辑引用"
            keytip="C"
            size="large"
            onAction="OnAction"
            getImage="GetImage"
          >
            <supertip>
              <title>插入/编辑引用</title>
              <text>搜索 LiteratureX 文库并插入引用</text>
            </supertip>
          </button>
          <button
            id="btnAddEditBib"
            label="插入/编辑参考文献"
            keytip="B"
            size="large"
            onAction="OnAction"
            getImage="GetImage"
          >
            <supertip>
              <title>插入/编辑参考文献</title>
              <text>在光标处插入参考文献表</text>
            </supertip>
          </button>
          <button
            id="btnRefresh"
            label="刷新"
            keytip="R"
            size="default"
            onAction="OnAction"
            getImage="GetImage"
          >
            <supertip>
              <title>刷新</title>
              <text>刷新文献库连接与搜索结果</text>
            </supertip>
          </button>
          <button
            id="btnPref"
            label="文档首选项"
            keytip="P"
            size="default"
            onAction="OnAction"
            getImage="GetImage"
          >
            <supertip>
              <title>文档首选项</title>
              <text>选择引用格式（数字或作者-年份）</text>
            </supertip>
          </button>
          <button
            id="btnAddNote"
            label="添加笔记"
            keytip="N"
            size="default"
            onAction="OnAction"
            getImage="GetImage"
          >
            <supertip>
              <title>添加笔记</title>
              <text>在 LiteratureX 中为文献添加阅读笔记</text>
            </supertip>
          </button>
          <button
            id="btnUnlink"
            label="解除链接"
            keytip="U"
            size="default"
            onAction="OnAction"
            getImage="GetImage"
          >
            <supertip>
              <title>解除链接</title>
              <text>将引用转换为普通文本（当前插件已使用纯文本引用）</text>
            </supertip>
          </button>
          <button
            id="btnExport"
            label="导出"
            keytip="E"
            size="default"
            onAction="OnAction"
            getImage="GetImage"
          >
            <supertip>
              <title>导出</title>
              <text>复制当前参考文献表到剪贴板</text>
            </supertip>
          </button>
          <button
            id="btnAbout"
            label="关于"
            keytip="A"
            size="large"
            onAction="OnAction"
            getImage="GetImage"
          >
            <supertip>
              <title>关于 LiteratureX</title>
              <text>文献发现、管理与引用插件</text>
            </supertip>
          </button>
        </group>
      </tab>
    </tabs>
  </ribbon>
</customUI>
